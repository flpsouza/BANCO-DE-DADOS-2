-- QUERY 1: O "Caminhão de Lixo" (SELECT * sem restrição e sem limite) 
SELECT * FROM clientes ORDER BY data_cadastro DESC;

R:
SELECT id, nome, email, data_cadastro
FROM clientes
ORDER BY data_cadastro DESC
LIMIT 50;

-- QUERY 2: Violação da hierarquia de índice (Leftmost Prefix ignorado) -- Cenário: A Tabela possui o índice composto (estado, cidade) 
SELECT id_cliente, rua, bairro FROM enderecos WHERE cidade = 'Campinas';

R:
-- 1 opção : Incluir a coluna do prefixo caso seja conhecida na aplicação
SELECT id_cliente, rua, bairro 
FROM enderecos 
WHERE estado = 'SP' AND cidade = 'Campinas';

