9ATV Gargalo de I/O por Subconsultas aninhadas com operador IN

– Não otimizado 
SELECT id, nome, email FROM clientes WHERE id IN ( SELECT id_cliente FROM pedidos WHERE id_produto IN ( SELECT id FROM produtos WHERE categoria = 'Eletronicos' ) );

– Otimizado 
SELECT DISTINCT c.id, c.nome, c.email 
FROM clientes c
INNER JOIN pedidos pe ON c.id = pe.id_cliente
INNER JOIN produtos pr ON pe.id_produto = pr.id
WHERE pr.categoria = 'Eletronicos';







