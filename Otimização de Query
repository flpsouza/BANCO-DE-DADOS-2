Otimizado
SELECT id_cliente, rua, bairro FROM enderecos WHERE estado = 'SP' AND cidade = 'Campinas';

-- QUERY 3: Junção Tardia com Nested Loop pesado (Falta de filtragem prévia) 
Não otimizado
SELECT p.id, c.nome, p.valor_total FROM pedidos p INNER JOIN clientes c ON p.id_cliente = c.id WHERE YEAR(p.data_pedido) = 2026;
Otimizado
SELECT p.id, c.nome, p.valor_total FROM (SELECT id, id_cliente, valor_total, data_pedido FROM pedidos WHERE data_pedido >= '2026-01-01' AND data_pedido < '2027-01-01') p INNER JOIN clientes c ON p.id_cliente = c.id;

